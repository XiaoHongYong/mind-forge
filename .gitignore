# Node
node_modules/
pnpm-debug.log*
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Package manager caches
.pnpm-store/
.npm/

# Frontend build outputs
frontend_app/dist/
frontend_app/.wrangler/
frontend_app/.vite/
frontend_app/*.tsbuildinfo
dist/

# Rust / Tauri build outputs
desktop/src-tauri/target/
target/
**/target/
desktop/src-tauri/target.release/
desktop/src-tauri/target.debug/

# Tauri bundles and updater artifacts
desktop/src-tauri/bundle/
desktop/src-tauri/gen/
desktop/src-tauri/*.sig

# OS / IDE
.DS_Store
Thumbs.db
.vscode/
.idea/
*.code-workspace
*.suo
*.user
*.userosscache
*.sln.docstates

# Local/personal helper files
*.local
*.tmp
*.bak
*.swp
*.orig
.history/
.cache/
.temp/
tmp/

# Local environment/tooling (keep examples tracked)
.python-version
.venv/
.venv*/
venv/
__pycache__/
*.pyc

# Env files
.env
.env.*
!.env.example

DECISIONS_NEEDED.md
OSS_SCOPE.md
RELEASE_PROCESS.md

# Local-only design planning — not for the public repo
/docs/ui-rework-plan.md
/docs/ui-mockups/
# Keep developer scripts tracked. Ignore only generated/backup files inside scripts/
/scripts/*.bak*
/scripts/*.tmp
/scripts/*.orig
/scripts/**/.cache/

# Local copilot instructions
.github/copilot-instructions.md
# Linux container build output
/dist-linux

# Snap build input: the deb copied in by hand before `snapcraft`, never committed.
desktop/snap/deb/
desktop/snap/*.snap

# Store packaging: signing material and built packages never belong here. The
# certificate lives in the Windows certificate store; see desktop/msix/build-msix.ps1.
*.pfx
*.p12
*.cer
*.p7b
*.snk
*.msix
*.msixupload
*.appx
*.appxupload

# HarmonyOS shell.
# `rawfile/www` is the synced frontend bundle — generated by `pnpm sync:ohos`,
# never edited by hand, and stale copies of content-hashed chunks would inflate
# the HAP.
ohos/.hvigor/
ohos/**/build/
ohos/**/oh_modules/
ohos/**/.preview/
ohos/**/node_modules/
ohos/entry/src/main/resources/rawfile/www/
# DevEco writes the local SDK path here; it is machine-specific.
ohos/local.properties
# Signing material is per-developer, generated inside DevEco Studio.
ohos/**/*.p12
ohos/**/*.cer
ohos/**/*.p7b
ohos/AppScope/resources/rawfile/agconnect-services.json
