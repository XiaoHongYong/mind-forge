{
  "name": "mindforge-oss-workspace",
  "private": true,
  "packageManager": "pnpm@10.17.1",
  "scripts": {
    "dev:app": "pnpm --dir frontend_app dev",
    "build:app": "pnpm --dir frontend_app build",
    "test:app": "pnpm --dir frontend_app test",
    "i18n:extract": "node scripts/i18n/extract.mjs",
    "i18n:pending": "node scripts/i18n/list-pending.mjs",
    "build:detect": "node scripts/build/build.mjs --detect",
    "build:all": "node scripts/build/build.mjs --all-possible",
  "sync:ohos": "node scripts/build/sync-ohos-assets.mjs",
  "check:ohos": "node scripts/build/sync-ohos-assets.mjs --check && pnpm check:ohos-bridge && pnpm check:ohos-signing",
  "check:ohos-bridge": "node scripts/build/check-ohos-bridge.mjs",
  "check:ohos-signing": "node scripts/build/check-ohos-signing.mjs",
  "build:ohos": "pnpm build:app && pnpm sync:ohos",
    "check:roundtrip": "node scripts/check_import_export_roundtrip.mjs",
    "tauri:dev": "pnpm --dir frontend_app tauri:dev",
    "tauri:build": "pnpm --dir frontend_app tauri:build",
    "build:linux": "docker build -f scripts/linux-build.Dockerfile --output type=local,dest=./dist-linux .",
    "build:linux:x64": "docker build --platform linux/amd64 -f scripts/linux-build.Dockerfile --output type=local,dest=./dist-linux ."
  }
}